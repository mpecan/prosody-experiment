    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
