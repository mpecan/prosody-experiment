{
  "name": "prosody-page",
  "private": true,
  "description": "The prosody page: write a poem and hear it. Built into dist/, served by prosody-web or as static files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
