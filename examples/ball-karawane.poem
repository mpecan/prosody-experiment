+++
# Hugo Ball, "Karawane" (1916; printed 1920, Dada Almanach). Text from de.wikisource.org/wiki/Karawane.
# A Dada sound poem: almost no word in it is in any dictionary, so it is all letter-to-sound.
[style]
scale       = "chromatic"
root        = "F"
tempo_range = [132, 140]
bank        = "tr808"
+++
jolifanto bambla ô falli bambla
grossiga m’pfa habla horem
égiga goramen
higo bloiko russula huju
hollaka hollala
anlogo bung
blago bung
blago bung
bosso fataka
ü üü ü
schampa wulla wussa ólobo
hej tatta gôrem
eschige zunbada
wulubu ssubudu uluw ssubudu
tumba ba- umf
kusagauma
ba - umf
