{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prosody",
  "version": "0.1.0",
  "identifier": "rocks.prosody",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev -- --host",
    "beforeBuildCommand": "cargo run -p prosody-web -- --site ../web/public && npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prosody",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
