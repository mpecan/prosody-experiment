{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prosody",
  "version": "0.1.0",
  "identifier": "rocks.prosody",
  "build": {
    "frontendDist": "../target/site",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "mise run dev:page --host",
    "beforeBuildCommand": "mise run site"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prosody",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 26
    }
  }
}
